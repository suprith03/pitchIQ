{
  "name": "@pitchiq/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "\"$NODE\" ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "\"$NODE\" -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && \"$NODE\" ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "clean": "\"$NODE\" -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "\"$NODE\" dist/index.js",
    "test": "\"$NODE\" ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "\"$NODE\" ../../node_modules/vitest/vitest.mjs",
    "lint": "\"$NODE\" ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@as-integrations/express4": "^1.1.2",
    "@apollo/server": "^5.5.1",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "graphql": "^16.11.0",
    "mongodb": "^6.18.0",
    "oracledb": "^6.10.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/oracledb": "^7.0.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
