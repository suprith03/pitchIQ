{
  "name": "pitchiq",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "\"$NODE\" node_modules/concurrently/dist/bin/concurrently.js -k -n api,web -c blue,green \"cd apps/api && \\\"$NODE\\\" ../../node_modules/tsx/dist/cli.mjs watch src/index.ts\" \"cd apps/web && \\\"$NODE\\\" ../../node_modules/vite/bin/vite.js\"",
    "dev:api": "cd apps/api && \"$NODE\" ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "dev:web": "cd apps/web && \"$NODE\" ../../node_modules/vite/bin/vite.js",
    "build": "cd apps/api && \"$NODE\" -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && \"$NODE\" ../../node_modules/typescript/bin/tsc -p tsconfig.json && cd ../web && \"$NODE\" ../../node_modules/typescript/bin/tsc -b && \"$NODE\" ../../node_modules/vite/bin/vite.js build",
    "test": "cd apps/api && \"$NODE\" ../../node_modules/vitest/vitest.mjs run && cd ../web && \"$NODE\" ../../node_modules/vitest/vitest.mjs run",
    "lint": "cd apps/api && \"$NODE\" ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && cd ../web && \"$NODE\" ../../node_modules/typescript/bin/tsc -b --pretty false",
    "benchmark": "\"$NODE\" --env-file-if-exists=.env scripts/benchmark.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
